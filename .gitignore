# Netlify
.netlify

# Environment variables — NEVER commit these
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Mac
.DS_Store
netlify/.DS_Store

# Lock files (optional — remove if you want to commit them)
# package-lock.json

# deno.lock is NOT one of those: it is not a dependency lock for this project,
# it is a bootstrap artifact `netlify dev` writes for the Deno edge runtime.
# This site deploys zero edge functions, so it is pure noise in the tree.
deno.lock

# Session/workflow artifacts
MORNING_REPORT.md
admin.html.backup-*
.claude/admin.html.b1-partial
.claude/night-plan.md
.claude/wave-b1-prompt.md

# Secrets that must never be committed even by accident
FME Passcodes/
*Passcode*

# SDD scratch workspace (ledger, briefs, review packages)
.superpowers/
